---
import "../styles/global.css"
import { SITE } from "@bpmnkit/astro-shared"
import Seo from "@bpmnkit/astro-shared/Seo.astro"
import { organizationJsonLd, softwareApplicationJsonLd } from "@bpmnkit/astro-shared/seo.js"
import { CONNECTOR_STATS } from "@bpmnkit/connector-gen"
import { Bpmn, exportSvg } from "@bpmnkit/core"
import Footer from "../components/Footer.astro"
import Nav from "../components/Nav.astro"
import { CODE_HTML, ECOSYSTEM } from "../data/content"

// The header carries the five destinations a cold visitor needs; everything
// else is reachable from the footer.
const navLinks = [
	{ href: "#why", label: "Why" },
	{ href: "#packages", label: "Packages" },
	{ href: "#camunda", label: "Camunda 8" },
	{ href: "#start", label: "Quickstart" },
	{ href: "https://docs.bpmnkit.com", label: "Docs" },
]

const jsonLd = [
	organizationJsonLd(),
	softwareApplicationJsonLd({
		name: SITE.name,
		description: SITE.description,
		url: SITE.url,
		applicationCategory: "DeveloperApplication",
		softwareVersion: ECOSYSTEM.find((pkg) => pkg.name === "@bpmnkit/core")?.version,
		license: "https://opensource.org/license/mit",
	}),
]

// The hero diagram is the real `exportSvg()` output of the hero snippet, built
// here so the code and the picture beside it can never drift apart. Once the
// page hydrates, the animated demo replaces it with a live canvas.
const heroSvg = exportSvg(
	Bpmn.createProcess("order-flow")
		.name("Order Flow")
		.startEvent("received", { name: "Order Received" })
		.serviceTask("validate", { name: "Validate Order", taskType: "validate-order" })
		.exclusiveGateway("ok", { name: "OK?" })
		.serviceTask("ship", { name: "Ship Order", taskType: "ship-order" })
		.endEvent("done", { name: "Done" })
		.withAutoLayout()
		.build(),
)
	// Retint the exporter's stock light theme to the page's own palette.
	.replace(/ width="[\d.]+" height="[\d.]+"/, "")
	.replaceAll("#f8f9fa", "#fbfbfc")
	.replaceAll("#404040", "#14161a")
	.replaceAll("#333333", "#14161a")

const withSdkCode = CODE_HTML.withSdk
const createProcessCode = CODE_HTML.createProcess
const deployRunCode = CODE_HTML.deployRun
const apiCode = CODE_HTML.apiClient
const dmnTableCode = CODE_HTML.dmnTable
const formExampleCode = CODE_HTML.formExample
const bpmnWithCompanionsCode = CODE_HTML.bpmnWithCompanions

const CAPABILITIES = [
	{
		title: "Auto-layout",
		body: "Sugiyama engine with orthogonal edge routing. No coordinate math, ever.",
		api: ".withAutoLayout()",
		href: "/auto-layout",
	},
	{
		title: "Type-safe",
		body: "29 guards narrow the <code>BpmnFlowElement</code> union. Errors are <code>instanceof</code>-catchable with machine-readable codes.",
		api: "isBpmnServiceTask(el)",
		href: null,
	},
	{
		title: "Roundtrip fidelity",
		body: "Parse → modify → export with no data loss. Zeebe extensions, custom namespaces and DI preserved.",
		api: "roundtrip test suite ↗",
		href: `${SITE.github}/blob/main/packages/core/tests/xml/xml-roundtrip.test.ts`,
	},
	{
		title: "Zero dependencies",
		body: "Pure ESM, tree-shakeable. Browsers, Node, Deno, Bun and edge runtimes.",
		api: "0 third-party deps",
		href: null,
	},
	{
		title: "DMN &amp; Forms",
		body: "The same builder pattern for DMN 1.3 decision tables and Camunda form JSON, referenced from the process.",
		api: "Dmn.createDecisionTable(id)",
		href: "#dmn-forms",
	},
	{
		title: "LLM-friendly format",
		body: "A compact intermediate form fits a whole diagram in one prompt. The SDK validates and renders what the model returns.",
		api: "compactify(defs) / expand(c)",
		href: null,
	},
]
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="BPMN Kit Blog" href="/rss.xml" />
  <Seo
    title="BPMN Kit — Generate BPMN diagrams with code"
    description="Open-source toolkit for building, simulating, and deploying business process (BPMN) diagrams with code and AI. Free, MIT-licensed, Camunda 8 compatible."
    jsonLd={jsonLd}
  />
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to content</a>
  <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>

  <Nav links={navLinks} showHomeLink={false} />

  <main id="main-content">

  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-body">
      <div class="hero-text">
        <div class="hero-eyebrow">TypeScript · BPMN 2.0 · MIT</div>
        <h1 class="hero-h1">BPMN diagrams<br>from code,<br>not clicks.</h1>
        <p class="hero-p">
          A fluent TypeScript API that generates deployable BPMN&nbsp;2.0 diagrams with
          <a href="/auto-layout">auto-layout</a> — for developers, automation platforms, and
          AI&nbsp;agents.
        </p>
        <p class="hero-p-sub">
          Analysts still review and edit everything visually. It replaces the
          copy-paste-redeploy gap between the diagram and production, not the diagram.
        </p>

        <button class="install-btn" id="install-btn" title="Click to copy">
          <code>pnpm add @bpmnkit/core</code>
          <span class="install-copied" aria-hidden="true"></span>
        </button>

        <div class="hero-ctas">
          <a href="https://docs.bpmnkit.com" class="btn-primary">Read the docs</a>
          <a href="/editor" class="btn-link">Open the editor — no install</a>
        </div>

        <div class="hero-stats">
          <div class="hero-stat">
            <div class="hero-stat-num">0</div>
            <div class="hero-stat-label">deps</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-num">ESM</div>
            <div class="hero-stat-label">node · deno · bun · edge</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-num">MIT</div>
            <div class="hero-stat-label">pre-1.0</div>
          </div>
        </div>
      </div>

      <div class="hero-panel">
        <p class="sr-only">
          The panel beside this text cycles through five example scripts, typing out a
          BPMN Kit builder call and rendering the resulting diagram live. The same
          builder API is available as static, editable code in the playground below.
        </p>
        <!-- aria-hidden — the text alternative above covers it; the constant DOM
             churn would otherwise be announced piecemeal by assistive tech. -->
        <div class="anim-demo" id="anim-demo" aria-hidden="true">
          <div class="panel-label" id="anim-filename">order-flow.ts</div>
          <div class="anim-code-panel">
            <div class="anim-code-body">
              <div id="anim-code-lines" class="anim-code-lines"><code set:html={withSdkCode}></code></div>
            </div>
          </div>

          <div class="hero-note">
            <span class="hero-note-mark">↓</span>
            valid BPMN 2.0 XML · layout computed · Zeebe extensions set
          </div>

          <div class="anim-diagram-panel">
            <div id="anim-diagram" class="anim-diagram-inner"><Fragment set:html={heroSvg} /></div>
            <div class="anim-progress" id="anim-progress">
              <div class="anim-bar"><div class="anim-bar-fill"></div></div>
              <div class="anim-bar"><div class="anim-bar-fill"></div></div>
              <div class="anim-bar"><div class="anim-bar-fill"></div></div>
              <div class="anim-bar"><div class="anim-bar-fill"></div></div>
              <div class="anim-bar"><div class="anim-bar-fill"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 01 · The same process, two ways ───────────────────────────────────── -->
  <section class="section section--alt" id="why">
    <div class="section-wrap">
      <div class="section-head">
        <span class="section-num">01</span>
        <h2 class="section-h2">The same process, two ways.</h2>
      </div>
      <div class="compare-grid">
        <div class="cmp-panel">
          <div class="panel-label">hand-written BPMN XML · 41 lines</div>
          <pre class="cmp-code cmp-code--xml">&lt;bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"&gt;
  &lt;bpmn:process id="p" isExecutable="true"&gt;
    &lt;bpmn:startEvent id="s"&gt;
      &lt;bpmn:outgoing&gt;Flow_1&lt;/bpmn:outgoing&gt;
    &lt;/bpmn:startEvent&gt;
    &lt;bpmn:serviceTask id="t"&gt;
      &lt;bpmn:extensionElements&gt;
        &lt;zeebe:taskDefinition type="worker"/&gt;
      &lt;/bpmn:extensionElements&gt;
      &lt;bpmn:incoming&gt;Flow_1&lt;/bpmn:incoming&gt;
      &lt;bpmn:outgoing&gt;Flow_2&lt;/bpmn:outgoing&gt;
    &lt;/bpmn:serviceTask&gt;
    &lt;bpmn:endEvent id="e"&gt;
      &lt;bpmn:incoming&gt;Flow_2&lt;/bpmn:incoming&gt;
    &lt;/bpmn:endEvent&gt;
    &lt;bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="t"/&gt;
    &lt;bpmn:sequenceFlow id="Flow_2" sourceRef="t" targetRef="e"/&gt;
  &lt;/bpmn:process&gt;
  &lt;bpmndi:BPMNDiagram&gt;
    &lt;bpmndi:BPMNPlane&gt;
      &lt;bpmndi:BPMNShape bpmnElement="s"&gt;
        &lt;dc:Bounds x="152" y="82" width="36" height="36"/&gt;</pre>
        </div>
        <div class="cmp-panel">
          <div class="panel-label panel-label--accent">with BPMN Kit · 13 lines</div>
          <pre class="cmp-code"><code set:html={withSdkCode}></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 02 · What you get ─────────────────────────────────────────────────── -->
  <section class="section" id="features">
    <div class="section-wrap">
      <div class="section-head">
        <span class="section-num">02</span>
        <h2 class="section-h2">What you get</h2>
      </div>
      <div class="hair-grid hair-grid--3">
        {CAPABILITIES.map((cap) => (
          <div class="cap-card">
            <h3 set:html={cap.title} />
            <p set:html={cap.body} />
            <div class="cap-api">
              {cap.href
                ? <a href={cap.href} target={cap.href.startsWith("http") ? "_blank" : undefined} rel={cap.href.startsWith("http") ? "noopener" : undefined}>{cap.api}</a>
                : cap.api}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 03 · Packages ─────────────────────────────────────────────────────── -->
  <section class="section section--ink" id="packages">
    <div class="section-wrap">
      <div class="section-head section-head--tight">
        <span class="section-num">03</span>
        <h2 class="section-h2">Six packages, pick what you need</h2>
      </div>
      <p class="section-sub">
        Independently versioned and pre-1.0, developed in the open under MIT. Everything
        below is installable today.
      </p>
      <div class="pkg-grid">
        {ECOSYSTEM.map((pkg) => (
          <a class="pkg-row" href={pkg.url} target="_blank" rel="noopener">
            <div class="pkg-main">
              <div class="pkg-name">{pkg.name}</div>
              <div class="pkg-role">
                {pkg.role}
                {pkg.note && <span class="pkg-caveat"> — {pkg.note}</span>}
              </div>
            </div>
            <div class="pkg-version">v{pkg.version}</div>
          </a>
        ))}
      </div>
      <div class="pkg-links">
        <a href={`${SITE.github}/releases`} target="_blank" rel="noopener">Changelog &amp; releases</a>
        <a href={`${SITE.github}/issues`} target="_blank" rel="noopener">Report an issue</a>
        <a href={SITE.npm} target="_blank" rel="noopener">npm</a>
        <a href="mailto:hello@bpmnkit.com">Contact</a>
      </div>
    </div>
  </section>

  <!-- ── 04 · Camunda 8 ────────────────────────────────────────────────────── -->
  <section class="section" id="camunda">
    <div class="section-wrap">
      <div class="section-head section-head--tight">
        <span class="section-num">04</span>
        <h2 class="section-h2">Camunda 8, end to end</h2>
      </div>
      <p class="section-sub">
        A fully typed REST client — 180 methods across 30+ resource classes, three auth
        modes, retry with backoff — plus <code>casen</code>, a terminal UI for the same API.
        And {CONNECTOR_STATS.services} built-in OpenAPI specs covering
        {" "}{CONNECTOR_STATS.endpoints.toLocaleString("en")} endpoints that generate typed
        Zeebe connector templates. <a href="/integrations">Browse the catalog →</a>
      </p>
      <div class="camunda-layout">
        <div>
          <div class="panel-label">client.ts</div>
          <pre class="code-panel"><code set:html={apiCode}></code></pre>
        </div>

        <div class="camunda-side">
          <div class="hair-grid hair-grid--2">
            <div class="metric">
              <div class="metric-num">180</div>
              <div class="metric-label">typed methods</div>
            </div>
            <div class="metric">
              <div class="metric-num">{CONNECTOR_STATS.services}</div>
              <div class="metric-label">connector specs</div>
            </div>
            <div class="metric">
              <div class="metric-num">3</div>
              <div class="metric-label">auth modes</div>
            </div>
            <div class="metric">
              <div class="metric-num">3×</div>
              <div class="metric-label">auto-retry</div>
            </div>
          </div>
          <div class="chips">
            <span class="chip">OAuth2 / Bearer / Basic</span>
            <span class="chip">LRU + TTL cache</span>
            <span class="chip">Exponential backoff</span>
            <span class="chip">TypedEventEmitter</span>
            <span class="chip">ESM tree-shakeable</span>
          </div>
        </div>
      </div>

      <div class="camunda-layout camunda-layout--flip">
        <div class="camunda-side">
          <div class="inset-card">
            <div class="inset-card-label">$ casen</div>
            <p>
              Interactive TUI over the same API: connection profiles for dev/staging/prod,
              processes, jobs, incidents, decisions and variables, with scrollable tabular
              output. <a href="/cli">Full command reference →</a>
            </p>
          </div>
          <div class="chips">
            <span class="chip">Processes</span>
            <span class="chip">Jobs &amp; Workers</span>
            <span class="chip">Decisions</span>
            <span class="chip">Messages</span>
            <span class="chip">Incidents</span>
            <span class="chip">Variables</span>
            <span class="chip">Signals</span>
          </div>
        </div>

        <div>
          <div class="panel-label">casen — interactive TUI</div>
          <div class="cli-terminal-wrap">
            <p class="sr-only">
              This terminal animates a demo session of casen, the BPMN Kit CLI: navigating
              the main menu, opening the process command group, listing process definitions
              and viewing a tabular result.
            </p>
            <!-- aria-hidden — the text alternative above covers it. -->
            <div id="cli-terminal" aria-hidden="true">
              <div class="cli-topbar">
                <span class="cli-topbar-title">casen</span>
              </div>
              <div class="cli-content"></div>
            </div>
            <div id="cli-key-badge"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 05 · Three steps ──────────────────────────────────────────────────── -->
  <section class="section section--alt" id="start">
    <div class="section-wrap">
      <div class="section-head">
        <span class="section-num">05</span>
        <h2 class="section-h2">Three steps to a deployable diagram</h2>
      </div>
      <div class="steps-grid">
        <div class="step">
          <div class="step-head">
            <span class="step-num">01</span>
            <h3>Install</h3>
            <span class="step-head-spacer"></span>
            <div class="pkg-tabs" role="group" aria-label="Package manager">
              <button class="pkg-tab active" data-pkg="pnpm" aria-pressed="true">pnpm</button>
              <button class="pkg-tab" data-pkg="bun" aria-pressed="false">bun</button>
              <button class="pkg-tab" data-pkg="npm" aria-pressed="false">npm</button>
              <button class="pkg-tab" data-pkg="yarn" aria-pressed="false">yarn</button>
            </div>
          </div>
          <pre class="pkg-cmd active" data-pkg="pnpm"><code><span class="comment">$</span> pnpm add @bpmnkit/core

<span class="comment"># optional</span>
<span class="comment">$</span> pnpm add @bpmnkit/api
<span class="comment">$</span> pnpm add -g casen</code></pre>
          <pre class="pkg-cmd" data-pkg="bun"><code><span class="comment">$</span> bun add @bpmnkit/core

<span class="comment"># optional</span>
<span class="comment">$</span> bun add @bpmnkit/api
<span class="comment">$</span> bun add -g casen</code></pre>
          <pre class="pkg-cmd" data-pkg="npm"><code><span class="comment">$</span> npm install @bpmnkit/core

<span class="comment"># optional</span>
<span class="comment">$</span> npm install @bpmnkit/api
<span class="comment">$</span> npm install -g casen</code></pre>
          <pre class="pkg-cmd" data-pkg="yarn"><code><span class="comment">$</span> yarn add @bpmnkit/core

<span class="comment"># optional</span>
<span class="comment">$</span> yarn add @bpmnkit/api
<span class="comment">$</span> yarn global add casen</code></pre>
        </div>

        <div class="step">
          <div class="step-head">
            <span class="step-num">02</span>
            <h3>Build a process</h3>
          </div>
          <pre><code set:html={createProcessCode}></code></pre>
        </div>

        <div class="step">
          <div class="step-head">
            <span class="step-num">03</span>
            <h3>Simulate, then deploy</h3>
          </div>
          <pre><code set:html={deployRunCode}></code></pre>
          <p class="step-note">
            The engine is an in-process simulator for tests and demos. Production execution
            runs on Camunda 8 / Zeebe via <code>@bpmnkit/api</code>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 06 · DMN & Forms ──────────────────────────────────────────────────── -->
  <section class="section" id="dmn-forms">
    <div class="section-wrap">
      <div class="section-head section-head--tight">
        <span class="section-num">06</span>
        <h2 class="section-h2">Decisions and forms, same builder</h2>
      </div>
      <p class="section-sub">
        DMN 1.3 decision tables and Camunda form JSON come out of the same fluent API, and
        a BPMN process can reference both.
      </p>

      <div class="dmn-tabs" role="tablist" aria-label="DMN and Forms examples">
        <button class="dmn-tab active" data-tab="dmn" role="tab" id="dmn-tab-dmn" aria-selected="true" aria-controls="dmn-panel-dmn" tabindex="0">DMN decision table</button>
        <button class="dmn-tab" data-tab="form" role="tab" id="dmn-tab-form" aria-selected="false" aria-controls="dmn-panel-form" tabindex="-1">Camunda form</button>
        <button class="dmn-tab" data-tab="bpmn" role="tab" id="dmn-tab-bpmn" aria-selected="false" aria-controls="dmn-panel-bpmn" tabindex="-1">BPMN with both</button>
      </div>

      <div class="dmn-panels">
        <div class="dmn-panel active" data-panel="dmn" id="dmn-panel-dmn" role="tabpanel" aria-labelledby="dmn-tab-dmn">
          <div class="dmn-layout">
            <div>
              <div class="panel-label">eligibility.ts</div>
              <div class="dmn-code-body">
                <pre><code set:html={dmnTableCode}></code></pre>
              </div>
            </div>
            <div class="dmn-desc">
              <h3>DMN decision tables</h3>
              <p>
                Define inputs, outputs and rules; the SDK emits valid DMN 1.3 XML with
                auto-computed DMNDI layout. <code>Dmn.createDecisionTable(id)</code> builds
                it, <code>Dmn.export(defs)</code> serialises it, <code>Dmn.layout(defs)</code>
                positions it.
              </p>
              <div class="dmn-chips">
                <span class="dmn-chip">Fluent builder</span>
                <span class="dmn-chip">DMN 1.3 XML</span>
                <span class="dmn-chip">Auto-layout DMNDI</span>
                <span class="dmn-chip">Hit policies</span>
                <span class="dmn-chip">FEEL type refs</span>
              </div>
            </div>
          </div>
        </div>

        <div class="dmn-panel" data-panel="form" id="dmn-panel-form" role="tabpanel" aria-labelledby="dmn-tab-form">
          <div class="dmn-layout">
            <div>
              <div class="panel-label">application-form.ts</div>
              <div class="dmn-code-body">
                <pre><code set:html={formExampleCode}></code></pre>
              </div>
            </div>
            <div class="dmn-desc">
              <h3>Camunda forms</h3>
              <p>
                Scaffold Camunda form JSON from code. <code>Form.makeEmpty(id)</code> gives a
                baseline structure; extend it with typed fields for text inputs, numbers and
                dropdowns.
              </p>
              <div class="dmn-chips">
                <span class="dmn-chip">Form JSON export</span>
                <span class="dmn-chip">textfield / number / select</span>
                <span class="dmn-chip">Schema version 16</span>
                <span class="dmn-chip">Round-trip fidelity</span>
              </div>
            </div>
          </div>
        </div>

        <div class="dmn-panel" data-panel="bpmn" id="dmn-panel-bpmn" role="tabpanel" aria-labelledby="dmn-tab-bpmn">
          <div class="dmn-layout">
            <div>
              <div class="panel-label">loan-application.ts</div>
              <div class="dmn-code-body">
                <pre><code set:html={bpmnWithCompanionsCode}></code></pre>
              </div>
            </div>
            <div class="dmn-desc">
              <h3>BPMN with DMN &amp; form references</h3>
              <p>
                Link a process to a decision table via <code>businessRuleTask</code> and to a
                form via <code>userTask</code>. Both use Zeebe extension attributes, so the
                process is immediately deployable to Camunda 8.
              </p>
              <div class="dmn-chips">
                <span class="dmn-chip">userTask → formId</span>
                <span class="dmn-chip">businessRuleTask → decisionId</span>
                <span class="dmn-chip">resultVariable</span>
                <span class="dmn-chip">Auto-layout</span>
              </div>
              <div id="dmn-bpmn-preview" class="dmn-bpmn-preview"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 07 · Playground ───────────────────────────────────────────────────── -->
  <section class="section section--alt" id="playground">
    <div class="section-wrap">
      <div class="section-head section-head--tight">
        <span class="section-num">07</span>
        <h2 class="section-h2">Try the builder in the browser</h2>
      </div>
      <p class="section-sub">
        Write <code>Bpmn</code>, <code>Dmn</code> and <code>Form</code> builder expressions.
        Press <kbd>Ctrl+Enter</kbd> (or <kbd>⌘ Enter</kbd>) to render. Nothing to install.
      </p>

      <div class="playground-wrap">
        <div class="pg-editor-panel">
          <div class="pg-topbar">
            <span class="pg-topbar-title">playground.ts</span>
