---
import "../styles/global.css"
import { SITE } from "@bpmnkit/astro-shared"
import Seo from "@bpmnkit/astro-shared/Seo.astro"
import { organizationJsonLd, softwareApplicationJsonLd } from "@bpmnkit/astro-shared/seo.js"
import { CONNECTOR_STATS } from "@bpmnkit/connector-gen"
import Footer from "../components/Footer.astro"
import Nav from "../components/Nav.astro"
import { CODE_HTML, ECOSYSTEM } from "../data/content"

// Nav order matches section DOM order (top to bottom), so clicking left-to-right
// scrolls strictly downward instead of jumping back and forth.
const navLinks = [
	{ href: "#features", label: "Features" },
	{ href: "#examples", label: "Examples" },
	{ href: "#api", label: "API" },
	{ href: "#cli", label: "CLI" },
	{ href: "#start", label: "Quickstart" },
	{ href: "#dmn-forms", label: "DMN & Forms" },
	{ href: "#playground", label: "Playground" },
	{ href: "/connectors", label: "Connectors" },
	{ href: "/use-cases", label: "Use Cases" },
	{ href: "/compare", label: "Compare" },
	{ href: "/blog", label: "Blog" },
	{ href: "https://docs.bpmnkit.com", label: "Docs" },
	{ href: "https://learn.bpmnkit.com", label: "Learn" },
	{ href: "/editor", label: "Editor" },
	{ href: "/operate", label: "Operate" },
]

const jsonLd = [
	organizationJsonLd(),
	softwareApplicationJsonLd({
		name: SITE.name,
		description: SITE.description,
		url: SITE.url,
		applicationCategory: "DeveloperApplication",
		softwareVersion: ECOSYSTEM.find((pkg) => pkg.name === "@bpmnkit/core")?.version,
		license: "https://opensource.org/license/mit",
	}),
]

const withSdkCode = CODE_HTML.withSdk
const createProcessCode = CODE_HTML.createProcess
const deployRunCode = CODE_HTML.deployRun
const apiCode = CODE_HTML.apiClient
const dmnTableCode = CODE_HTML.dmnTable
const formExampleCode = CODE_HTML.formExample
const bpmnWithCompanionsCode = CODE_HTML.bpmnWithCompanions
const typeGuardsCode = CODE_HTML.typeGuards
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="BPMN Kit Blog" href="/rss.xml" />
  <Seo
    title="BPMN Kit — Generate BPMN diagrams with code"
    description="Open-source toolkit for building, simulating, and deploying business process (BPMN) diagrams with code and AI. Free, MIT-licensed, Camunda 8 compatible."
    jsonLd={jsonLd}
  />
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to content</a>
  <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>

  <!-- Fixed page background — aurora orbs, dot grid, grain texture.
       position:fixed + z-index:-1 keeps them behind all content while
       the user scrolls, giving the whole page a consistent ambient glow. -->
  <div class="aurora" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>
  <div class="dots" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <!-- Scroll progress (pure CSS) -->
  <div class="scroll-bar" aria-hidden="true"></div>

  <!-- Nav -->
  <Nav links={navLinks} showHomeLink={false} />

  <main id="main-content">

  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-body">
      <div class="hero-text">
        <div class="pill">
          <span class="pill-dot"></span>
          Open Source · MIT · AI-Native · TypeScript
        </div>
        <h1 class="hero-h1">
          BPMN diagrams<br>
          <span class="shimmer-text">from code, not clicks</span>
        </h1>
        <p class="hero-p">
          A fluent TypeScript API that generates deployable BPMN&nbsp;2.0 diagrams
          with auto-layout. Built for <strong>AI&nbsp;agents</strong>, automation platforms,
          and workflow builders.
        </p>
        <p class="hero-p-sub">
          BPMN is the industry standard for business-process diagrams. BPMN Kit lets your
          developers — and AI assistants — create, test, and deploy them as fast as they write
          code. Analysts still review and edit everything visually in the built-in editor.
        </p>
        <div class="hero-ctas">
          <button class="install-btn" id="install-btn" title="Click to copy">
            <svg class="install-icon" width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4.5" y="4.5" width="9" height="9" rx="1.5"/><path d="M2.5 11.5H1.5a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v1"/></svg>
            <code>pnpm add @bpmnkit/core</code>
            <span class="install-copied" aria-hidden="true">Copied!</span>
          </button>
          <a href="https://docs.bpmnkit.com" class="btn-primary">
            Get Started
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a href="/editor" class="btn-ghost">Open the visual editor — no install</a>
          <a href="https://github.com/bpmnkit/monorepo" class="btn-ghost" target="_blank" rel="noopener">GitHub →</a>
        </div>
      </div>

      <!-- Live BPMN diagram preview (rendered by @bpmnkit/canvas) -->
      <div class="hero-diagram">
        <div class="diagram-card">
          <div class="diagram-topbar">
            <span class="tb-dot tb-red"></span>
            <span class="tb-dot tb-yellow"></span>
            <span class="tb-dot tb-green"></span>
            <span class="tb-title">order-flow.bpmn</span>
          </div>
          <div id="diagram-hero" class="diagram-canvas-wrap"></div>
        </div>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="scroll-hint" aria-hidden="true">
      <div class="scroll-hint-dot"></div>
    </div>
  </section>

  <!-- ── Features Bento ───────────────────────────────────────────────────── -->
  <section class="features" id="features">
    <div class="section-wrap">
      <div class="section-eyebrow">Why BPMN Kit</div>
      <h2 class="section-h2">Everything you need,<br>nothing you don't</h2>
      <div class="bento" id="bento">
        <!-- Large: AI-Native -->
        <div class="bcard bcard-lg">
          <div class="bcard-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <div class="bcard-body">
            <h3>AI-Native Design</h3>
            <p>LLMs call a fluent API instead of wrestling with raw XML. A compact intermediate format makes the entire diagram fit in a single prompt — AI generates it, the SDK validates and renders it.</p>
          </div>
          <div class="bcard-chip">
            <span class="kw">const</span> compact = <span class="fn">compactify</span>(defs)<br>
            <span class="kw">const</span> xml = Bpmn.<span class="fn">export</span>(<span class="fn">expand</span>(compact))
          </div>
        </div>

        <!-- Tall: Zero Deps -->
        <div class="bcard bcard-tall">
          <div class="bcard-icon bcard-icon--teal">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>No Third-Party<br>Dependencies</h3>
          <p>Pure ESM, tree-shakeable. Runs in browsers, Node, Deno, Bun, and edge runtimes.</p>
          <div class="deps-ring">
            <div class="deps-center">0</div>
            <div class="deps-label">third-party deps</div>
          </div>
        </div>

        <!-- Normal: Auto-Layout -->
        <div class="bcard">
          <div class="bcard-icon bcard-icon--pink">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </div>
          <h3>Auto-Layout</h3>
          <p>Sugiyama layout engine produces clean, readable diagrams with orthogonal edge routing. No coordinate math.</p>
          <div class="bcard-chips">
            <span class="dmn-chip">Sugiyama algorithm</span>
            <span class="dmn-chip">SVG export</span>
          </div>
        </div>

        <!-- Normal: Type-Safe -->
        <div class="bcard">
          <div class="bcard-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Type-Safe</h3>
          <p>Strict TypeScript throughout. 29 type guard predicates narrow the <code>BpmnFlowElement</code> union. Typed errors are <code>instanceof</code>-catchable.</p>
          <div class="bcard-chips">
            <span class="dmn-chip">29 type guards</span>
            <span class="dmn-chip">ParseError / ValidationError</span>
            <span class="dmn-chip">findElement / getZeebeExtensions</span>
          </div>
        </div>

        <!-- Wide: Roundtrip -->
        <div class="bcard bcard-wide">
          <div class="bcard-icon bcard-icon--teal">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          </div>
          <div>
            <h3>Roundtrip Fidelity</h3>
            <p>Parse → modify → export without data loss. All Zeebe extensions, custom namespaces, and diagram info preserved — <a href="https://github.com/bpmnkit/monorepo/blob/main/packages/core/tests/xml/xml-roundtrip.test.ts" target="_blank" rel="noopener">verified by the roundtrip test suite</a>.</p>
          </div>
          <div class="roundtrip-flow">
            <span class="rt-step">Parse</span>
            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M1 5h14M11 1l4 4-4 4" stroke="oklch(65% 0.28 280 / 0.7)" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span class="rt-step">Modify</span>
            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M1 5h14M11 1l4 4-4 4" stroke="oklch(65% 0.28 280 / 0.7)" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span class="rt-step">Export</span>
          </div>
        </div>

        <!-- Wide: Camunda 8 -->
        <div class="bcard bcard-wide">
          <div class="bcard-icon bcard-icon--pink">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <h3>Camunda&nbsp;8 Ready</h3>
            <p>Native Zeebe task definitions, IO mappings, connectors, forms, and modeler templates. Deploy directly to Camunda Cloud.</p>
          </div>
        </div>

        <!-- Wide: Connector Catalog -->
        <div class="bcard bcard-wide">
          <div class="bcard-icon bcard-icon--teal">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <div>
            <h3>{CONNECTOR_STATS.services} API Connectors, Out&nbsp;of&nbsp;the&nbsp;Box</h3>
            <p>Generate typed Zeebe connector templates from {CONNECTOR_STATS.services} built-in OpenAPI specs — GitHub, Stripe, Slack, DigitalOcean, Kubernetes, and more. Over {(CONNECTOR_STATS.endpoints).toLocaleString("en")} API endpoints covered with zero boilerplate.</p>
          </div>
          <div class="bcard-chips">
            <span class="dmn-chip">{CONNECTOR_STATS.services} services</span>
            <span class="dmn-chip">{CONNECTOR_STATS.endpoints.toLocaleString("en")}+ endpoints</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── For Process Teams ────────────────────────────────────────────────── -->
  <section class="teams-section" id="teams">
    <div class="section-wrap">
      <div class="section-eyebrow">For process teams</div>
      <h2 class="section-h2">Your analysts model it.<br>Your developers ship it. AI drafts it.</h2>
      <div class="teams-grid">
        <div class="teams-card">
          <h3>Faster process changes</h3>
          <p>Process updates ship through code review — versioned, tested, and audit-traceable — not a modeling-tool ritual.</p>
        </div>
        <div class="teams-card">
          <h3>AI-drafted workflows</h3>
          <p>Describe a process in plain language; get a valid, deployable BPMN diagram your analysts review visually.</p>
        </div>
        <div class="teams-card">
          <h3>No lock-in, no license fees</h3>
          <p>Open source (MIT). Standard BPMN&nbsp;2.0 files that open in any BPMN tool, including Camunda Modeler.</p>
        </div>
      </div>
      <p class="teams-note">
        BPMN Kit doesn't replace visual modeling — the built-in editor and any BPMN&nbsp;2.0 tool
        still open every diagram. It replaces the copy-paste-redeploy gap between the diagram and
        production. <a href="/use-cases">Explore use cases →</a>
      </p>
    </div>
  </section>

  <!-- ── SDK Developer Experience ────────────────────────────────────────── -->
  <section class="sdk-dx-section">
    <div class="section-wrap">
      <div class="section-eyebrow">SDK Quality</div>
      <h2 class="section-h2">TypeScript-first,<br>from top to bottom</h2>
      <div class="sdk-dx-layout">
        <!-- Left: feature list -->
        <div class="sdk-dx-features">
          <div class="sdk-dx-item">
            <div class="sdk-dx-bullet" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <h3>29 Type Guard Predicates</h3>
              <p>Narrow <code>BpmnFlowElement</code> to a specific type without casting. One predicate per BPMN element type — <code>isBpmnServiceTask</code>, <code>isBpmnParallelGateway</code>, <code>isBpmnBoundaryEvent</code>, and group guards like <code>isBpmnGateway</code>, <code>isBpmnActivity</code>, <code>isBpmnEvent</code>.</p>
            </div>
          </div>
          <div class="sdk-dx-item">
            <div class="sdk-dx-bullet" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div>
              <h3>Typed Error Classes</h3>
              <p><code>ParseError</code> (malformed XML) and <code>ValidationError</code> (builder rule violations) both extend <code>BpmnSdkError</code>. Every error carries a machine-readable <code>code</code> string — no string matching on <code>err.message</code>.</p>
            </div>
          </div>
          <div class="sdk-dx-item">
            <div class="sdk-dx-bullet" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <div>
              <h3>Element Lookup Utilities</h3>
              <p><code>findElement</code>, <code>findProcess</code>, <code>findSequenceFlow</code>, <code>getAllElements</code>, and <code>getZeebeExtensions</code> give you a clean query layer over the parsed model — no manual array traversal.</p>
            </div>
          </div>
          <div class="sdk-dx-item">
            <div class="sdk-dx-bullet" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div>
              <h3>Full JSDoc Coverage</h3>
              <p>Every public API has <code>@param</code>, <code>@returns</code>, <code>@throws</code>, and <code>@example</code> documentation. Hover any function in your IDE and get complete usage guidance inline.</p>
            </div>
          </div>
        </div>

        <!-- Right: code panel -->
        <div class="sdk-dx-code-panel">
          <div class="diagram-topbar">
            <span class="tb-dot tb-red"></span>
            <span class="tb-dot tb-yellow"></span>
            <span class="tb-dot tb-green"></span>
            <span class="tb-title">type-guards.ts</span>
          </div>
          <div class="sdk-dx-code-body">
            <pre><code set:html={typeGuardsCode}></code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Code Comparison ──────────────────────────────────────────────────── -->
  <section class="compare-section">
    <div class="section-wrap">
      <div class="section-eyebrow">Developer Experience</div>
      <h2 class="section-h2">Stop writing XML.<br>Start building workflows.</h2>
      <p class="section-sub" style="text-align:center; margin-top: -16px; margin-bottom: 28px;">Drag the divider to compare</p>

      <div class="compare-slider" id="compare-slider">
        <div class="compare-panels">
        <!-- Left: raw XML (without SDK) -->
        <div class="cmp-panel cmp-bad cmp-left">
          <div class="cmp-header">
            <span class="tb-dot tb-red"></span>
            <span class="tb-dot tb-yellow"></span>
            <span class="tb-dot tb-green"></span>
            <span class="cmp-label cmp-label-bad">Without SDK</span>
          </div>
          <pre class="cmp-code"><code>&lt;<span class="xml-tag">bpmn:definitions</span>
  <span class="xml-attr">xmlns:bpmn</span>=<span class="str">"http://www.omg.org/spec/BPMN/20100524/MODEL"</span>
  <span class="xml-attr">xmlns:bpmndi</span>=<span class="str">"http://www.omg.org/spec/BPMN/20100524/DI"</span>
  <span class="xml-attr">xmlns:zeebe</span>=<span class="str">"http://camunda.org/schema/zeebe/1.0"</span>&gt;
  &lt;<span class="xml-tag">bpmn:process</span> <span class="xml-attr">id</span>=<span class="str">"p"</span> <span class="xml-attr">isExecutable</span>=<span class="str">"true"</span>&gt;
    &lt;<span class="xml-tag">bpmn:startEvent</span> <span class="xml-attr">id</span>=<span class="str">"s"</span>&gt;
      &lt;<span class="xml-tag">bpmn:outgoing</span>&gt;Flow_1&lt;/<span class="xml-tag">bpmn:outgoing</span>&gt;
    &lt;/<span class="xml-tag">bpmn:startEvent</span>&gt;
    &lt;<span class="xml-tag">bpmn:serviceTask</span> <span class="xml-attr">id</span>=<span class="str">"t"</span>&gt;
      &lt;<span class="xml-tag">bpmn:extensionElements</span>&gt;
        &lt;<span class="xml-tag">zeebe:taskDefinition</span>
          <span class="xml-attr">type</span>=<span class="str">"worker"</span>/&gt;
      &lt;/<span class="xml-tag">bpmn:extensionElements</span>&gt;
      &lt;<span class="xml-tag">bpmn:incoming</span>&gt;Flow_1&lt;/<span class="xml-tag">bpmn:incoming</span>&gt;
      &lt;<span class="xml-tag">bpmn:outgoing</span>&gt;Flow_2&lt;/<span class="xml-tag">bpmn:outgoing</span>&gt;
    &lt;/<span class="xml-tag">bpmn:serviceTask</span>&gt;
    &lt;<span class="xml-tag">bpmn:endEvent</span> <span class="xml-attr">id</span>=<span class="str">"e"</span>&gt;
      &lt;<span class="xml-tag">bpmn:incoming</span>&gt;Flow_2&lt;/<span class="xml-tag">bpmn:incoming</span>&gt;
    &lt;/<span class="xml-tag">bpmn:endEvent</span>&gt;
    &lt;<span class="xml-tag">bpmn:sequenceFlow</span> <span class="xml-attr">id</span>=<span class="str">"Flow_1"</span>
      <span class="xml-attr">sourceRef</span>=<span class="str">"s"</span> <span class="xml-attr">targetRef</span>=<span class="str">"t"</span>/&gt;
    &lt;<span class="xml-tag">bpmn:sequenceFlow</span> <span class="xml-attr">id</span>=<span class="str">"Flow_2"</span>
      <span class="xml-attr">sourceRef</span>=<span class="str">"t"</span> <span class="xml-attr">targetRef</span>=<span class="str">"e"</span>/&gt;
  &lt;/<span class="xml-tag">bpmn:process</span>&gt;
  &lt;<span class="xml-tag">bpmndi:BPMNDiagram</span>&gt;
    &lt;<span class="xml-tag">bpmndi:BPMNPlane</span>&gt;
      &lt;<span class="xml-tag">bpmndi:BPMNShape</span>
        <span class="xml-attr">bpmnElement</span>=<span class="str">"s"</span>&gt;
        &lt;<span class="xml-tag">dc:Bounds</span> <span class="xml-attr">x</span>=<span class="str">"152"</span> <span class="xml-attr">y</span>=<span class="str">"82"</span>
          <span class="xml-attr">width</span>=<span class="str">"36"</span> <span class="xml-attr">height</span>=<span class="str">"36"</span>/&gt;
      &lt;/<span class="xml-tag">bpmndi:BPMNShape</span>&gt;
      <span class="comment">&lt;!-- ...more shapes + edges... --&gt;</span>
    &lt;/<span class="xml-tag">bpmndi:BPMNPlane</span>&gt;
  &lt;/<span class="xml-tag">bpmndi:BPMNDiagram</span>&gt;
&lt;/<span class="xml-tag">bpmn:definitions</span>&gt;</code></pre>
        </div>

        <!-- Right: with BPMN Kit -->
        <div class="cmp-panel cmp-good cmp-right">
          <div class="cmp-header">
            <span class="tb-dot tb-red"></span>
            <span class="tb-dot tb-yellow"></span>
            <span class="tb-dot tb-green"></span>
            <span class="cmp-label cmp-label-good">With BPMN Kit</span>
          </div>
          <pre class="cmp-code"><code set:html={withSdkCode}></code></pre>
        </div>

        </div><!-- /.compare-panels -->

        <!-- Drag handle — outside compare-panels so the knob isn't clipped -->
        <div class="cmp-divider" aria-hidden="true">
          <div class="cmp-divider-line"></div>
          <div
            class="cmp-divider-knob"
            role="slider"
            tabindex="0"
            aria-label="Comparison divider — Without SDK vs. With BPMN Kit"
            aria-valuemin="5"
            aria-valuemax="95"
            aria-valuenow="50"
            id="cmp-divider-knob"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5L3 12l5 7V5zM16 5l5 7-5 7V5z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

