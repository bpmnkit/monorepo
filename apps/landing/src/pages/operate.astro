---
import "../styles/fonts.css"
import Seo from "@bpmnkit/astro-shared/Seo.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo
      title="Operate — BPMN Kit"
      description="Monitor and operate running Camunda 8 process instances — a lightweight Operate-style dashboard powered by @bpmnkit/operate."
    />
    <style is:global>
      /* @bpmnkit/operate brings its own chrome, on the same design system as the
         rest of the site. The page only has to hand it the ground, the type and
         the whole viewport. */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        height: 100%;
        overflow: hidden;
        background: var(--bpmnkit-ds-bg, #f4f5f7);
        color: var(--bpmnkit-ds-ink, #14161a);
        font-family: var(--bpmnkit-ds-font-sans, "Space Grotesk", system-ui, sans-serif);
        font-size: 14.5px;
      }
      #operate-container { position: fixed; inset: 0; }
      #operate-container .op-root { height: 100%; }
    </style>
  </head>
  <body>
    <div id="operate-container"></div>
    <script>
      import "../scripts/operate.ts";
    </script>
  </body>
</html>
