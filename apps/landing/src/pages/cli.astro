---
import "../styles/global.css"
import Seo from "@bpmnkit/astro-shared/Seo.astro"
import Footer from "../components/Footer.astro"
import Nav from "../components/Nav.astro"
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <Seo
    title="casen CLI — Manage Camunda 8 from your terminal · BPMN Kit"
    description="casen is the official command-line interface for Camunda 8. Deploy processes, manage incidents, query instances, and generate connectors — all from your terminal."
  />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/asciinema-player@3/dist/bundle/asciinema-player.css" />
  <style is:global>
    /* ── Page layout ────────────────────────────────────────────────── */
    .cli-page-wrap {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }

    .cli-page-wrap section {
      border-bottom: 1px solid var(--rule);
    }

    .cli-page-wrap .section-wrap {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: var(--section-pad) var(--gutter);
    }

    /* ── Hero ───────────────────────────────────────────────────────── */
    .cli-hero {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: calc(var(--nav-h) + 72px) var(--gutter) 64px;
    }

    .cli-hero-eyebrow {
      font-family: var(--font-mono);
      font-size: 11.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 22px;
    }

    .cli-hero-title {
      font-family: var(--font-mono);
      font-size: clamp(3rem, 8vw, 4.5rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.04em;
      margin-bottom: 20px;
    }

    .cli-hero-sub {
      font-size: 18px;
      line-height: 1.5;
      color: var(--ink-body);
      max-width: 34em;
      margin-bottom: 30px;
      text-wrap: pretty;
    }

    .cli-install-box {
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid var(--ink);
      padding: 11px 14px;
      font-family: var(--font-mono);
      font-size: 13.5px;
      color: var(--ink);
      width: fit-content;
      max-width: 100%;
      margin-bottom: 24px;
    }

    .cli-install-prompt {
      color: var(--accent);
      user-select: none;
    }

    .cli-install-copy {
      background: none;
      border: 0;
      color: var(--ink-meta);
      cursor: pointer;
      padding: 2px 4px;
      display: flex;
      align-items: center;
    }

    .cli-install-copy:hover {
      color: var(--accent);
    }

    .cli-hero-ctas {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    /* ── Demo / asciinema ───────────────────────────────────────────── */
    .cli-demo-section {
      background: var(--ground-alt);
    }

    .cli-demo-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: var(--section-pad) var(--gutter);
    }

    .cli-demo-player {
      border: 1px solid var(--rule);
      overflow: hidden;
      background: var(--code-bg);
    }

    .cli-demo-caption {
      margin-top: 12px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--ink-meta);
    }

    /* ── Features grid ──────────────────────────────────────────────── */
    .cli-feat-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--rule);
      border: 1px solid var(--rule);
      margin-top: 28px;
    }

    .cli-feat-card {
      background: var(--ground);
      padding: 26px 24px;
    }

    .cli-feat-icon {
      color: var(--accent);
      margin-bottom: 14px;
      display: flex;
    }

    .cli-feat-card h3 {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .cli-feat-card p {
      font-size: 14px;
      color: var(--ink-body-soft);
      line-height: 1.55;
    }

    .cli-feat-card code {
      font-family: var(--font-mono);
      font-size: 12.5px;
    }

    /* ── Commands reference ─────────────────────────────────────────── */
    .cli-cmds-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr));
      gap: 20px;
      margin-top: 28px;
    }

    .cli-cmd-group {
      border: 1px solid var(--rule);
      background: var(--panel);
      overflow-x: auto;
      min-width: 0;
    }

    .cli-cmd-group-header {
      padding: 12px 18px;
      border-bottom: 1px solid var(--rule);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .cli-cmd-group-icon {
      color: var(--accent);
    }

    .cli-cmd-group-title {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-meta);
    }

    .cli-cmd-table {
      width: 100%;
      border-collapse: collapse;
    }

    .cli-cmd-table tr {
      border-bottom: 1px solid var(--rule);
    }

    .cli-cmd-table tr:last-child {
      border-bottom: none;
    }

    .cli-cmd-table td {
      padding: 9px 18px;
      font-size: 13px;
      vertical-align: middle;
    }

    .cli-cmd-table td:first-child {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--ink);
      white-space: nowrap;
      width: 1%;
      padding-right: 10px;
    }

    .cli-cmd-table td:last-child {
      color: var(--ink-body-soft);
    }

    /* ── Output formats ─────────────────────────────────────────────── */
    .cli-output-section {
      background: var(--ground-alt);
    }

    .cli-output-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 28px;
    }

    .cli-output-card {
      background: var(--code-bg);
      min-width: 0;
    }

    .cli-output-card-header {
      padding: 10px 18px;
      border-bottom: 1px solid var(--ink-rule);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .cli-output-card-title {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-fg-muted);
    }

    .cli-output-flag {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--accent-on-ink);
      border: 1px solid var(--ink-rule);
      padding: 2px 8px;
    }

    .cli-output-card pre {
      padding: 18px;
      margin: 0;
      font-family: var(--font-mono);
      font-size: 12.5px;
      line-height: 1.7;
      color: var(--code-fg);
      overflow-x: auto;
    }

    .cli-output-card pre .k { color: var(--code-fn); }
    .cli-output-card pre .s { color: var(--code-str); }
    .cli-output-card pre .n { color: var(--accent-on-ink); }
    .cli-output-card pre .h { color: var(--code-comment); }

    /* ── Global flags ───────────────────────────────────────────────── */
    .cli-flags-table {
      width: 100%;
      min-width: 480px;
      border-collapse: collapse;
      margin-top: 28px;
      border: 1px solid var(--rule);
      background: var(--panel);
    }

    .cli-flags-table th {
      padding: 11px 18px;
      font-family: var(--font-mono);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-meta);
      text-align: left;
      border-bottom: 1px solid var(--rule);
    }

    .cli-flags-table td {
      padding: 11px 18px;
      font-size: 13px;
      border-bottom: 1px solid var(--rule);
      vertical-align: middle;
    }

    .cli-flags-table tr:last-child td {
      border-bottom: none;
    }

    .cli-flags-table td:first-child,
    .cli-flags-table td:nth-child(2) {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--ink);
      white-space: nowrap;
    }

    .cli-flags-table td:last-child {
      color: var(--ink-body-soft);
    }

    /* ── Shell completion ───────────────────────────────────────────── */
    .cli-completion-section {
      background: var(--ground-alt);
    }

    .cli-completion-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 28px;
    }

    .cli-completion-card {
      background: var(--code-bg);
      min-width: 0;
    }

    .cli-completion-card-header {
      padding: 10px 18px;
      border-bottom: 1px solid var(--ink-rule);
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--ink-fg-muted);
    }

    .cli-completion-card pre {
      padding: 16px 18px;
      margin: 0;
      font-family: var(--font-mono);
      font-size: 12.5px;
      line-height: 1.7;
      color: var(--code-fg);
      overflow-x: auto;
    }

    .cli-completion-card pre .c { color: var(--code-comment); }
    .cli-completion-card pre .cmd { color: var(--code-fn); }

    /* ── Install ────────────────────────────────────────────────────── */
    .cli-install-tabs-wrap {
      max-width: 560px;
      margin: 28px auto 0;
      text-align: left;
    }

    .cli-pkg-tabs {
      display: flex;
      border: 1px solid var(--rule);
      width: fit-content;
      margin-bottom: 12px;
    }

    .cli-pkg-tab {
      background: none;
      border: 0;
      border-right: 1px solid var(--rule);
      padding: 5px 12px;
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--ink-body-soft);
      cursor: pointer;
    }

    .cli-pkg-tab:last-child {
      border-right: 0;
    }

    .cli-pkg-tab:hover {
      color: var(--accent);
    }

    .cli-pkg-tab.active {
      background: var(--ink);
      color: var(--ground);
    }

    .cli-pkg-cmd {
      display: none;
      background: var(--code-bg);
      padding: 14px 18px;
      font-family: var(--font-mono);
      font-size: 13.5px;
      color: var(--code-fg);
    }

    .cli-pkg-cmd.active {
      display: block;
    }

    .cli-pkg-cmd .prompt {
      color: var(--accent-on-ink);
      user-select: none;
    }

    /* ── Responsive ─────────────────────────────────────────────────── */
    @media (max-width: 1040px) {
      .cli-feat-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .cli-output-layout,
      .cli-completion-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {
      .cli-feat-grid,
      .cli-cmds-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <Nav />

  <div class="cli-page-wrap">
  <main style="flex: 1;">

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="cli-hero">
    <div class="cli-hero-eyebrow">
      Command-Line Interface
    </div>
    <h1 class="cli-hero-title">
      casen
    </h1>
    <p class="cli-hero-sub">
      Manage Camunda&nbsp;8 clusters from your terminal.
      Deploy processes, resolve incidents, query instances,
      and generate connector templates — all with one tool.
    </p>
    <div class="cli-install-box" id="install-box">
      <span class="cli-install-prompt">$</span>
      <span class="cli-install-cmd" id="install-cmd">npm install -g @bpmnkit/cli</span>
      <button class="cli-install-copy" id="copy-btn" aria-label="Copy install command" title="Copy">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
      </button>
    </div>
    <div class="cli-hero-ctas">
      <a href="https://www.npmjs.com/package/@bpmnkit/cli" class="btn-primary" target="_blank" rel="noopener">
        View on npm
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
      <a href="https://github.com/bpmnkit/monorepo/tree/main/apps/cli" class="btn-ghost" target="_blank" rel="noopener">
        Source on GitHub
      </a>
    </div>
  </section>

  <!-- ── Demo ──────────────────────────────────────────────────────── -->
  <section class="cli-demo-section">
    <div class="cli-demo-inner">
      <div class="cli-demo-player" id="demo"></div>
      <p class="cli-demo-caption">
        Profile setup → process list → deploy → incidents → JSON output
      </p>
    </div>
  </section>

  <!-- ── Features ──────────────────────────────────────────────────── -->
  <section class="cli-feat-section">
    <div class="section-wrap">
      <div class="section-eyebrow">What it does</div>
      <h2 class="section-h2">Everything you need<br>for Camunda 8 ops</h2>
      <div class="cli-feat-grid">

        <div class="cli-feat-card">
          <div class="cli-feat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
          </div>
          <h3>Interactive TUI</h3>
          <p>Navigate menus, commands, and input forms with arrow keys. Run <code style="font-family:var(--font-mono);font-size:12px;color:var(--accent)">casen</code> with no arguments to enter the full TUI.</p>
        </div>

        <div class="cli-feat-card">
          <div class="cli-feat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>Connection Profiles</h3>
          <p>Store multiple clusters — dev, staging, prod. Switch with <code style="font-family:var(--font-mono);font-size:12px;color:var(--accent)">--profile</code> or <code style="font-family:var(--font-mono);font-size:12px;color:var(--accent)">casen profile use</code>. Supports Bearer, OAuth2, and Basic auth.</p>
        </div>

        <div class="cli-feat-card">
          <div class="cli-feat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Full API Coverage</h3>
          <p>Processes, instances, incidents, jobs, decisions, variables, messages, and signals — all 34 resource groups, 180+ operations.</p>
        </div>

        <div class="cli-feat-card">
          <div class="cli-feat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3>Connector Generation</h3>
          <p>Point <code style="font-family:var(--font-mono);font-size:12px;color:var(--accent)">casen connector generate</code> at an OpenAPI or Swagger spec and get ready-to-use Camunda element templates.</p>
        </div>

        <div class="cli-feat-card">
          <div class="cli-feat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </div>
          <h3>Flexible Output</h3>
          <p>Human-readable tables by default. Add <code style="font-family:var(--font-mono);font-size:12px;color:var(--accent)">--json</code> for machine-readable output. Pipe straight into <code style="font-family:var(--font-mono);font-size:12px;color:var(--accent)">jq</code> or scripts.</p>
        </div>

        <div class="cli-feat-card">
          <div class="cli-feat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
          <h3>Shell Completion</h3>
          <p>Tab completion for bash, zsh, and fish. One command to install. Never mistype a subcommand again.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Commands ──────────────────────────────────────────────────── -->
  <section class="cli-cmds-section">
    <div class="section-wrap">
      <div class="section-eyebrow">Reference</div>
      <h2 class="section-h2">Commands</h2>

      <div class="cli-cmds-grid">

        <!-- Profile -->
        <div class="cli-cmd-group">
          <div class="cli-cmd-group-header">
            <svg class="cli-cmd-group-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span class="cli-cmd-group-title">Profile</span>
          </div>
          <table class="cli-cmd-table" aria-label="Profile commands">
            <tbody>
              <tr><td>casen profile list</td><td>List all saved profiles</td></tr>
              <tr><td>casen profile add &lt;name&gt;</td><td>Add a profile interactively</td></tr>
              <tr><td>casen profile use &lt;name&gt;</td><td>Switch the active profile</td></tr>
              <tr><td>casen profile remove &lt;name&gt;</td><td>Delete a profile</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Processes -->
        <div class="cli-cmd-group">
          <div class="cli-cmd-group-header">
            <svg class="cli-cmd-group-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M20.188 10.934c.2.649.312 1.337.312 2.066s-.112 1.417-.312 2.066l2.069.888a1 1 0 0 1 .499 1.316l-1 2a1 1 0 0 1-1.316.499l-2.069-.888A9.958 9.958 0 0 1 14 20.92V23h-4v-2.08a9.958 9.958 0 0 1-4.371-2.039l-2.069.888a1 1 0 0 1-1.316-.499l-1-2a1 1 0 0 1 .499-1.316l2.069-.888C3.612 14.417 3.5 13.729 3.5 13s.112-1.417.312-2.066L1.743 10.046a1 1 0 0 1-.499-1.316l1-2a1 1 0 0 1 1.316-.499l2.069.888A9.958 9.958 0 0 1 10 5.08V3h4v2.08a9.958 9.958 0 0 1 4.371 2.039l2.069-.888a1 1 0 0 1 1.316.499l1 2a1 1 0 0 1-.499 1.316l-2.069.888z"/></svg>
            <span class="cli-cmd-group-title">Processes</span>
          </div>
          <table class="cli-cmd-table" aria-label="Process commands">
            <tbody>
              <tr><td>casen processes list</td><td>List deployed process definitions</td></tr>
              <tr><td>casen instances list</td><td>List process instances</td></tr>
              <tr><td>casen instances cancel &lt;key&gt;</td><td>Cancel a running instance</td></tr>
              <tr><td>casen deploy &lt;file&gt;</td><td>Deploy a BPMN, DMN, or form file</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Incidents & Jobs -->
        <div class="cli-cmd-group">
          <div class="cli-cmd-group-header">
            <svg class="cli-cmd-group-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span class="cli-cmd-group-title">Incidents &amp; Jobs</span>
          </div>
          <table class="cli-cmd-table" aria-label="Incident and job commands">
            <tbody>
              <tr><td>casen incidents list</td><td>List open incidents</td></tr>
              <tr><td>casen incidents resolve &lt;key&gt;</td><td>Resolve an incident</td></tr>
              <tr><td>casen jobs list</td><td>List active jobs</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Decisions & Variables -->
        <div class="cli-cmd-group">
          <div class="cli-cmd-group-header">
            <svg class="cli-cmd-group-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span class="cli-cmd-group-title">Decisions &amp; Variables</span>
          </div>
          <table class="cli-cmd-table" aria-label="Decision and variable commands">
            <tbody>
              <tr><td>casen decisions list</td><td>List deployed decision definitions</td></tr>
              <tr><td>casen variables list &lt;key&gt;</td><td>List variables for a process instance</td></tr>
              <tr><td>casen messages publish</td><td>Publish a message correlation</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Connectors -->
        <div class="cli-cmd-group">
          <div class="cli-cmd-group-header">
            <svg class="cli-cmd-group-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span class="cli-cmd-group-title">Connector</span>
          </div>
          <table class="cli-cmd-table" aria-label="Connector commands">
            <tbody>
              <tr><td>casen connector generate &lt;spec&gt;</td><td>Generate element templates from OpenAPI/Swagger</td></tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Output formats ────────────────────────────────────────────── -->
  <section class="cli-output-section">
    <div class="section-wrap">
      <div class="section-eyebrow">Output</div>
      <h2 class="section-h2">Human-readable<br>or machine-friendly</h2>
      <div class="cli-output-layout">

        <div class="cli-output-card">
          <div class="cli-output-card-header">
            <span class="cli-output-card-title">Table (default)</span>
            <span class="cli-output-flag">casen processes list</span>
          </div>
          <pre>  <span class="h">Name                  Version  Deployed</span>
  <span class="h">─────────────────────────────────────────────</span>
  order-process         <span class="n">3</span>        2026-03-15 09:42
  payment-gateway       <span class="n">1</span>        2026-03-14 14:22
  notification-flow     <span class="n">2</span>        2026-03-12 11:08

  <span class="h">3 process definitions</span></pre>
        </div>

        <div class="cli-output-card">
          <div class="cli-output-card-header">
            <span class="cli-output-card-title">JSON</span>
            <span class="cli-output-flag">--json</span>
          </div>
          <pre>[
  &#123;
    <span class="k">"key"</span>: <span class="n">2251799813685229</span>,
    <span class="k">"name"</span>: <span class="s">"order-process"</span>,
    <span class="k">"version"</span>: <span class="n">3</span>,
    <span class="k">"bpmnProcessId"</span>: <span class="s">"order-process"</span>
  &#125;
]</pre>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Global flags ──────────────────────────────────────────────── -->
  <section class="cli-flags-section">
    <div class="section-wrap">
      <div class="section-eyebrow">Flags</div>
      <h2 class="section-h2">Global options</h2>
      <div class="table-scroll">
      <table class="cli-flags-table" aria-label="Global CLI flags">
        <thead>
          <tr>
            <th>Flag</th>
            <th>Value</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>--profile</td>
            <td>&lt;name&gt;</td>
            <td>Use a specific saved connection profile for this command</td>
          </tr>
          <tr>
            <td>--json</td>
            <td>—</td>
            <td>Output results as JSON instead of a table</td>
          </tr>
          <tr>
            <td>--help</td>
            <td>—</td>
            <td>Show help for a command</td>
          </tr>
        </tbody>
      </table>
      </div>
    </div>
  </section>

  <!-- ── Shell completion ───────────────────────────────────────────── -->
  <section class="cli-completion-section">
    <div class="section-wrap">
      <div class="section-eyebrow">Shell completion</div>
      <h2 class="section-h2">Tab completion<br>for every shell</h2>
      <div class="cli-completion-grid">

        <div class="cli-completion-card">
          <div class="cli-completion-card-header">bash</div>
          <pre><span class="c"># Add to ~/.bashrc</span>
<span class="cmd">eval "$(casen completion bash)"</span></pre>
        </div>

        <div class="cli-completion-card">
          <div class="cli-completion-card-header">zsh</div>
          <pre><span class="c"># Add to ~/.zshrc</span>
<span class="cmd">eval "$(casen completion zsh)"</span></pre>
        </div>

        <div class="cli-completion-card">
          <div class="cli-completion-card-header">fish</div>
          <pre><span class="c"># Add to fish config</span>
<span class="cmd">casen completion fish \
  | source</span></pre>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Install ────────────────────────────────────────────────────── -->
  <section class="cli-install-section">
    <div class="section-wrap" style="text-align: center;">
      <div class="section-eyebrow">Get started</div>
      <h2 class="section-h2">Install in seconds</h2>
      <p class="section-sub">Available on npm. Works with npm, pnpm, bun, and yarn.</p>

      <div class="cli-install-tabs-wrap">
        <div class="cli-pkg-tabs" role="tablist">
          <button class="cli-pkg-tab active" data-pkg="npm" role="tab">npm</button>
          <button class="cli-pkg-tab" data-pkg="pnpm" role="tab">pnpm</button>
          <button class="cli-pkg-tab" data-pkg="bun" role="tab">bun</button>
          <button class="cli-pkg-tab" data-pkg="yarn" role="tab">yarn</button>
        </div>
        <pre class="cli-pkg-cmd active" data-pkg="npm"><code><span class="prompt">$</span> npm install -g @bpmnkit/cli</code></pre>
        <pre class="cli-pkg-cmd" data-pkg="pnpm"><code><span class="prompt">$</span> pnpm add -g @bpmnkit/cli</code></pre>
        <pre class="cli-pkg-cmd" data-pkg="bun"><code><span class="prompt">$</span> bun add -g @bpmnkit/cli</code></pre>
        <pre class="cli-pkg-cmd" data-pkg="yarn"><code><span class="prompt">$</span> yarn global add @bpmnkit/cli</code></pre>

        <p style="margin-top: 24px; font-size: 13.5px; color: var(--text-muted);">
          Then run <code style="font-family:var(--font-mono);color:var(--accent);font-size:13px;">casen</code> to launch the interactive TUI,
          or <code style="font-family:var(--font-mono);color:var(--accent);font-size:13px;">casen --help</code> to see all commands.
        </p>
      </div>
    </div>
  </section>

  </main>

  <!-- ── Footer ───────────────────────────────────────────────────── -->
  <Footer />
  </div>

  <!-- Asciinema player -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/asciinema-player@3/dist/bundle/asciinema-player.min.js"></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('demo');
      if (el && window.AsciinemaPlayer) {
        window.AsciinemaPlayer.create('/casen-demo.cast', el, {
          autoPlay: true,
          loop: true,
          speed: 1.5,
          theme: 'monokai',
          fit: 'width',
          terminalFontFamily: '"Space Mono", ui-monospace, monospace',
          terminalFontSize: '14px',
        });
      }
    })();
  </script>

  <script is:inline>
    // Install cmd copy
    (function () {
      var copyBtn = document.getElementById('copy-btn');
      var cmdEl = document.getElementById('install-cmd');
      if (!copyBtn || !cmdEl) return;
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(cmdEl.textContent || '').then(function () {
          copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
          setTimeout(function () {
            copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
          }, 1500);
        });
      });
    })();

    // Install tabs
    (function () {
      var tabs = document.querySelectorAll('.cli-pkg-tab');
      var cmds = document.querySelectorAll('.cli-pkg-cmd');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var pkg = tab.dataset.pkg;
          tabs.forEach(function (t) { t.classList.remove('active'); });
          cmds.forEach(function (c) { c.classList.remove('active'); });
          tab.classList.add('active');
          var cmd = document.querySelector('.cli-pkg-cmd[data-pkg="' + pkg + '"]');
          if (cmd) cmd.classList.add('active');
        });
      });
    })();
  </script>
</body>
</html>
