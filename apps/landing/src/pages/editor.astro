---
import Seo from "@bpmnkit/astro-shared/Seo.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo
      title="BPMN Editor — BPMN Kit"
      description="Design and edit BPMN 2.0 diagrams in the browser — a drag-and-drop editor with a properties panel and AI bridge, powered by @bpmnkit/editor."
    />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { height: 100dvh; overflow: hidden; font-family: system-ui, sans-serif; font-size: 13px; }
      #editor-container { position: fixed; inset: 0; }
      #editor-container .bpmn-controls { display: none; }
    </style>
  </head>
  <body>
    <div id="editor-container"></div>
    <script>
      import "../scripts/editor.ts";
    </script>
  </body>
</html>
