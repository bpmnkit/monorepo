    <a href="/docs/guides/ai">AI guide</a>
    <a href="/blog/generate-bpmn-diagrams-programmatically-typescript">Generate BPMN with TypeScript</a>
    <a href="https://learn.bpmnkit.com/glossary">BPMN glossary</a>
  </div>
</UseCase>
