---
import "../styles/global.css"
import Seo from "@bpmnkit/astro-shared/Seo.astro"
import Footer from "../components/Footer.astro"
import Nav from "../components/Nav.astro"
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <Seo
    title="404 — Page not found · BPMN Kit"
    description="This page doesn't exist — but your processes can still run."
    noindex
  />
  <style>
    .nf-wrap {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }

    .nf-body {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: calc(var(--nav-h) + 64px) 24px 80px;
    }

    .nf-inner {
      text-align: center;
      max-width: 560px;
    }

    .nf-code {
      font-family: var(--font-mono);
      font-size: clamp(6rem, 18vw, 9rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.05em;
      color: var(--ink);
      margin-bottom: 32px;
    }

    /* Mini BPMN flow diagram — decorative */
    .nf-flow {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 36px;
      opacity: 0.65;
    }

    .nf-h1 {
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 700;
      color: var(--text);
      margin-bottom: 14px;
      letter-spacing: -0.02em;
    }

    .nf-p {
      font-size: 15px;
      color: var(--text-muted);
      line-height: 1.75;
      margin-bottom: 40px;
    }

    .nf-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

  </style>
</head>
<body>

  <!-- Nav -->
  <Nav />

  <div class="nf-wrap">
    <div class="nf-body">
      <div class="nf-inner">

        <div class="nf-code" role="img" aria-label="404">404</div>

        <!-- Decorative BPMN process flow -->
        <div class="nf-flow" aria-hidden="true">
          <svg width="280" height="56" viewBox="0 0 280 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Start event -->
            <circle cx="22" cy="28" r="16" stroke="#14161a" stroke-width="1.5"/>
            <!-- Arrow: start → task -->
            <line x1="38" y1="28" x2="58" y2="28" stroke="#14161a" stroke-width="1.5"/>
            <path d="M55 23.5 L62 28 L55 32.5" stroke="#14161a" stroke-width="1.5" stroke-linejoin="round"/>
            <!-- Task box -->
            <rect x="62" y="10" width="98" height="36" rx="6" stroke="#14161a" stroke-width="1.5"/>
            <text x="111" y="32" text-anchor="middle" font-size="11" fill="#14161a" font-family="Space Mono, ui-monospace, monospace">GET /this-page</text>
            <!-- Arrow: task → end -->
            <line x1="160" y1="28" x2="182" y2="28" stroke="#14161a" stroke-width="1.5"/>
            <path d="M179 23.5 L186 28 L179 32.5" stroke="#14161a" stroke-width="1.5" stroke-linejoin="round"/>
            <!-- Error end event (thick border = end event, lightning bolt = error) -->
            <circle cx="202" cy="28" r="16" stroke="#a8503a" stroke-width="3"/>
            <circle cx="202" cy="28" r="12" stroke="#a8503a" stroke-width="1" stroke-dasharray="2 2" opacity="0.4"/>
            <!-- Lightning bolt (error marker) -->
            <path d="M205 18 L199 27 L204 27 L199 38 L207 25 L202 25 Z" fill="#a8503a" opacity="0.9"/>
          </svg>
        </div>

        <h1 class="nf-h1">Page not found</h1>
        <p class="nf-p">
          This sequence flow reached a dead end.<br>
          The page you're looking for doesn't exist or was moved.
        </p>

        <div class="nf-actions">
          <a href="/" class="btn-primary">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M1 8.5L8 2l7 6.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3 7v7h4v-4h2v4h4V7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to home
          </a>
          <a href="/editor" class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="1.5" y="1.5" width="13" height="13" rx="2"/>
              <path d="M5 8h6M8 5v6" stroke-linecap="round"/>
            </svg>
            Open editor
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- Footer -->
  <Footer />

</body>
</html>
