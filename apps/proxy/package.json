{
	"name": "@bpmnkit/proxy",
	"version": "0.0.27",
	"description": "Local proxy server for BPMN Kit — AI bridge (SSE/MCP) and Camunda API proxy using stored CLI profiles",
	"type": "module",
	"bin": {
		"bpmn-ai-server": "./dist/index.js",
		"bpmn-mcp": "./dist/mcp-server.js",
		"bpmn-aikit": "./dist/aikit-mcp.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./dist/aikit-mcp.js": "./dist/aikit-mcp.js"
	},
	"files": ["LICENSE", "README.md", "dist/**/*.js"],
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@bpmnkit/api": "workspace:*",
		"@bpmnkit/core": "workspace:*",
		"@bpmnkit/patterns": "workspace:*",
		"@bpmnkit/profiles": "workspace:*",
		"better-sqlite3": "^12.8.0",
		"imapflow": "^1.2.18",
		"isolated-vm": "^7.0.0",
		"nodemailer": "^6.10.1"
	},
	"scripts": {
		"start": "node dist/index.js",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"test": "vitest run",
		"dev": "node --watch dist/index.js",
		"bridge": "esbuild src/bridge.ts --bundle --format=iife --global-name=Bridge --platform=neutral --outfile=dist/bridge.bundle.js",
		"bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs && esbuild src/mcp-server.ts --bundle --platform=node --format=cjs --outfile=dist/mcp-server.cjs && esbuild src/aikit-mcp.ts --bundle --platform=node --format=cjs --outfile=dist/aikit-mcp.cjs && pnpm run bridge"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/bpmnkit/monorepo"
	},
	"keywords": [
		"bpmn",
		"camunda",
		"proxy",
		"ai",
		"mcp",
		"server-sent-events",
		"typescript",
		"zeebe"
	],
	"license": "MIT",
	"homepage": "https://bpmnkit.com",
	"bugs": {
		"url": "https://github.com/bpmnkit/monorepo/issues"
	}
}
