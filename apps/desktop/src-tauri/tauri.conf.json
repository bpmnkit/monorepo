{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BPMN Kit",
  "version": "../package.json",
  "identifier": "com.bpmnkit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BPMN Kit",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../proxy-rs/target/release/ai-server": "ai-server",
      "../../proxy-rs/target/release/bpmn-mcp": "bpmn-mcp"
    },
    "shortDescription": "BPMN, DMN and Camunda Form editor",
    "publisher": "BPMN Kit",
    "homepage": "https://bpmnkit.com",
    "license": "MIT",
    "category": "DeveloperTool"
  }
}
