{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"types": ["vscode", "node"],
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"noEmit": true,
		"rootDir": ".",
		"verbatimModuleSyntax": false
	},
	"include": ["src", "tests", "scripts"],
	"exclude": ["src/webview"]
}
