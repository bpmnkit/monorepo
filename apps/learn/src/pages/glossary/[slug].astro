---
import { breadcrumbJsonLd, faqJsonLd } from "@bpmnkit/astro-shared/seo.js"
import GlossaryDiagram from "../../components/GlossaryDiagram.astro"
import { glossary } from "../../glossary/data.js"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { tutorials } from "../../tutorials/index.js"

export async function getStaticPaths() {
	return glossary.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}))
}

const { entry } = Astro.props as { entry: (typeof glossary)[number] }
const relatedTutorial = entry.relatedTutorialId
	? tutorials.find((t) => t.id === entry.relatedTutorialId)
	: undefined

const pageUrl = `https://learn.bpmnkit.com/glossary/${entry.slug}`
const jsonLd = [
	faqJsonLd([
		{ question: `What is a ${entry.term.toLowerCase()} in BPMN?`, answer: entry.shortDefinition },
	]),
	breadcrumbJsonLd([
		{ name: "Tutorials", url: "https://learn.bpmnkit.com" },
		{ name: "Glossary", url: "https://learn.bpmnkit.com/glossary" },
		{ name: entry.term, url: pageUrl },
	]),
]
---

<BaseLayout title={entry.term} description={entry.shortDefinition} jsonLd={jsonLd}>
  <section class="glossary-detail">
    <div class="glossary-breadcrumb">
      <a href="/">Tutorials</a> / <a href="/glossary">Glossary</a> / {entry.term}
    </div>

    <h1>{entry.term}</h1>
    <p class="glossary-lede">{entry.shortDefinition}</p>

    <div class="glossary-diagram-frame">
      <GlossaryDiagram symbols={entry.diagram} />
    </div>

    {entry.definition.map((paragraph) => (
      <p class="glossary-paragraph">{paragraph}</p>
    ))}

    <h2>Example</h2>
    <pre class="glossary-code"><code>{entry.codeExample}</code></pre>

    {relatedTutorial && (
      <a href={`/${relatedTutorial.id}`} class="glossary-tutorial-link">
        Try it hands-on: {relatedTutorial.title} →
      </a>
    )}
  </section>
</BaseLayout>

<style>
  /* The detail page's type, frame and code panel are on the design system in
     `styles/learn.css`. */
</style>
