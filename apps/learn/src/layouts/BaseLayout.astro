---
import "@bpmnkit/astro-shared/tokens.css"
import "@bpmnkit/astro-shared/background.css"
import Seo from "@bpmnkit/astro-shared/Seo.astro"
import { organizationJsonLd } from "@bpmnkit/astro-shared/seo.js"
import "../styles/fonts.css"
import "../styles/learn.css"

interface Props {
	title: string
	description?: string
	jsonLd?: object | object[]
}
const {
	title,
	description = "Interactive BPMN tutorials — learn by doing",
	jsonLd = [],
} = Astro.props
const allJsonLd = [organizationJsonLd(), ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo title={`${title} — BPMN Kit Learn`} description={description} jsonLd={allJsonLd} />
  </head>
  <body>
    <nav class="learn-nav">
      <div class="learn-nav-inner">
        {/* The wordmark, not the logo lockup: the system spends its one accent
            on "kit" and has no second brand colour to give a mark. */}
        <a href="/" class="learn-logo">
          <span class="learn-logo-mark">bpmn<span class="learn-logo-kit">kit</span></span>
          <span class="learn-logo-app">Learn</span>
        </a>
        <div class="learn-nav-links">
          <a href="/">Tutorials</a>
          <a href="/glossary">Glossary</a>
          <a href="https://bpmnkit.com/docs" target="_blank" rel="noopener">Docs ↗</a>
          <a href="https://github.com/bpmnkit/monorepo" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="learn-footer">
      <div class="footer-inner">
        <span>© 2026 BPMN Kit</span>
        <a href="/glossary">Glossary</a>
        <a href="https://github.com/bpmnkit/monorepo">GitHub</a>
        <a href="https://bpmnkit.com/docs">Docs</a>
      </div>
    </footer>
  </body>
</html>
