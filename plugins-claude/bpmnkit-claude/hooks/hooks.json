{
	"hooks": {
		"SessionStart": [
			{
				"type": "command",
				"command": "which casen > /dev/null 2>&1 || echo 'BPMNKit plugin: casen CLI not found. Install with: npm install -g @bpmnkit/cli'"
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "FILE=$(node -e \"try{const i=JSON.parse(process.env.CLAUDE_TOOL_INPUT||'{}');process.stdout.write(i.file_path||i.path||'')}catch{}\"); [[ \"$FILE\" == *.bpmn ]] && casen lint lint \"$FILE\" 2>/dev/null || true"
					}
				]
			}
		]
	}
}
