{
  "version": 1,
  "process": { "id": "charge-with-refund", "name": "Charge With Refund" },
  "steps": [
    { "kind": "start", "name": "Charge requested" },
    {
      "kind": "serviceTask",
      "id": "charge_card",
      "name": "Charge card",
      "jobType": "charge:1",
      "errorBoundary": {
        "errorCode": "CHARGE_FAILED",
        "steps": [
          { "kind": "serviceTask", "id": "refund_charge", "name": "Refund charge", "jobType": "refund:1" },
          { "kind": "end", "id": "charge_failed_end", "name": "Charge failed", "errorCode": "CHARGE_FAILED" }
        ]
      }
    },
    { "kind": "end", "name": "Charge succeeded" }
  ],
  "tests": [
    {
      "name": "Charge succeeds",
      "mocks": { "charge:1": { "outputs": {} } },
      "expect": { "path": ["charge_card"] }
    },
    {
      "name": "Charge fails and refunds",
      "mocks": {
        "charge:1": { "error": { "code": "CHARGE_FAILED", "message": "card declined" } },
        "refund:1": { "outputs": {} }
      },
      "expect": { "path": ["charge_card", "refund_charge", "charge_failed_end"] }
    }
  ]
}
