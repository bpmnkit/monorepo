{
	"version": 1,
	"process": { "id": "order-fulfillment", "name": "Order Fulfillment" },
	"steps": [
		{ "kind": "start", "name": "Fulfillment started" },
		{
			"kind": "gateway",
			"id": "fulfillment_split",
			"gatewayType": "parallel",
			"branches": [
				{
					"steps": [
						{
							"kind": "serviceTask",
							"id": "pick_items",
							"name": "Pick items",
							"jobType": "warehouse:pick:1"
						}
					]
				},
				{
					"steps": [
						{
							"kind": "serviceTask",
							"id": "pack_box",
							"name": "Pack box",
							"jobType": "warehouse:pack:1"
						}
					]
				},
				{
					"steps": [
						{
							"kind": "serviceTask",
							"id": "print_label",
							"name": "Print shipping label",
							"jobType": "warehouse:print-label:1"
						}
					]
				}
			]
		},
		{
			"kind": "serviceTask",
			"id": "dispatch_package",
			"name": "Dispatch package",
			"jobType": "shipping:dispatch:1"
		},
		{ "kind": "end", "name": "Order dispatched" }
	],
	"tests": [
		{
			"name": "All three fulfillment tasks complete before dispatch",
			"mocks": {
				"warehouse:pick:1": { "outputs": {} },
				"warehouse:pack:1": { "outputs": {} },
				"warehouse:print-label:1": { "outputs": {} },
				"shipping:dispatch:1": { "outputs": {} }
			},
			"expect": { "path": ["pick_items", "pack_box", "print_label", "dispatch_package"] }
		}
	]
}
