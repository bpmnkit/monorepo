{
	"name": "@bpmnkit/feel",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["LICENSE", "README.md", "dist/**/*.js", "dist/**/*.d.ts"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"test": "vitest run",
		"tck:extract": "node tasks/extract-tck-tests.mjs",
		"tck": "node tasks/extract-tck-tests.mjs && vitest run tests/tck.test.ts",
		"tck:run": "vitest run tests/tck.test.ts"
	},
	"dependencies": {},
	"description": "FEEL (Friendly Enough Expression Language) parser, evaluator, formatter and highlighter — 94% DMN TCK conformance",
	"keywords": ["feel", "dmn", "expression", "camunda", "bpmn", "typescript", "evaluator"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bpmnkit/monorepo"
	},
	"homepage": "https://bpmnkit.com",
	"bugs": {
		"url": "https://github.com/bpmnkit/monorepo/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
