{
	"name": "@bpmnkit/engine",
	"version": "1.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./wasm-runner": {
			"types": "./dist/wasm-runner.d.ts",
			"import": "./dist/wasm-runner.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./testing/vitest": {
			"types": "./dist/testing/vitest.d.ts",
			"import": "./dist/testing/vitest.js"
		}
	},
	"files": ["LICENSE", "README.md", "dist/**/*.js", "dist/**/*.d.ts"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "biome check ."
	},
	"dependencies": {
		"@bpmnkit/core": "workspace:^",
		"@bpmnkit/feel": "workspace:^"
	},
	"optionalDependencies": {
		"@bpmnkit/reebe-wasm": "workspace:^"
	},
	"peerDependencies": {
		"vitest": ">=2.0.0"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"description": "Lightweight BPMN 2.0 process simulator for tests and demos in browsers and Node.js — zero dependencies",
	"keywords": ["bpmn", "engine", "simulation", "workflow", "typescript", "dmn", "camunda"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bpmnkit/bpmnkit"
	},
	"homepage": "https://bpmnkit.com",
	"bugs": {
		"url": "https://github.com/bpmnkit/bpmnkit/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
