{
	"name": "@bpmnkit/markdown",
	"version": "0.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"bpmnkit-md": "./dist/cli.js"
	},
	"files": ["LICENSE", "README.md", "dist/**/*.js", "dist/**/*.d.ts"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
		"check": "biome check .",
		"test": "vitest run"
	},
	"dependencies": {
		"@bpmnkit/core": "workspace:^"
	},
	"description": "Real BPMN diagrams in Markdown — render bpmn and bpmn-compact code blocks to inline, themeable, accessible SVG",
	"keywords": [
		"bpmn",
		"markdown",
		"remark",
		"markdown-it",
		"mdx",
		"svg",
		"diagram",
		"docs-as-code",
		"astro",
		"docusaurus",
		"vitepress"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bpmnkit/monorepo"
	},
	"homepage": "https://bpmnkit.com",
	"bugs": {
		"url": "https://github.com/bpmnkit/monorepo/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
