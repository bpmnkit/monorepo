{
	"name": "@bpmnkit/monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.21.0",
	"scripts": {
		"build": "node scripts/sync-license.mjs && node scripts/generate-readmes.mjs && node scripts/check-packages.mjs && pnpm turbo build",
		"typecheck": "pnpm turbo typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "pnpm turbo test",
		"check": "pnpm turbo check",
		"verify": "pnpm turbo build typecheck check test",
		"changeset": "changeset",
		"version-packages": "changeset version && pnpm format",
		"release": "pnpm turbo build && changeset publish",
		"fix-bpmn": "node scripts/fix-bpmn.mjs",
		"update-connectors": "node scripts/update-connectors.mjs",
		"docs:dev": "pnpm --filter @bpmnkit/landing dev",
		"docs:build": "pnpm turbo build --filter @bpmnkit/landing",
		"proxy": "pnpm --filter @bpmnkit/proxy start",
		"proxy-rs": "cargo build --manifest-path apps/proxy-rs/Cargo.toml && apps/proxy-rs/target/debug/ai-server",
		"proxy-rs:build": "cargo build --manifest-path apps/proxy-rs/Cargo.toml --release",
		"desktop:dev": "pnpm --filter @bpmnkit/desktop tauri:dev",
		"desktop:build": "pnpm --filter @bpmnkit/desktop tauri:build",
		"build:wasm": "WASM_VERSION=$(node -p \"require('./apps/reebe-wasm/package.json').version\") && wasm-pack build apps/reebe/crates/reebe-wasm --target web --scope bpmnkit --out-dir \"$(pwd)/apps/reebe-wasm\" && node scripts/patch-wasm-pkg.mjs \"$WASM_VERSION\"",
		"bootstrap": "pnpm install && pnpm build:wasm"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9",
		"@astrojs/rss": "^4.0.12",
		"@astrojs/sitemap": "^3.7.1",
		"@biomejs/biome": "^1.9.4",
		"@changesets/cli": "^2.29.8",
		"@cloudflare/workers-types": "^5.20260708.1",
		"@preact/preset-vite": "^2.9.0",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "^4.0.0",
		"@tauri-apps/cli": "^2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.0.0",
		"@types/nodemailer": "^6.4.17",
		"astro": "^6",
		"concurrently": "^9.0.0",
		"esbuild": "^0.27.0",
		"happy-dom": "^20.7.0",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.0.0",
		"turbo": "^2.4.4",
		"typescript": "^5.7.3",
		"vite": "^8.0.3",
		"vitest": "^3.0.5",
		"wrangler": "^4.110.0",
		"yaml": "^2.8.2"
	}
}
